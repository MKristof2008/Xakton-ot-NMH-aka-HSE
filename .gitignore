# секреты и локальные данные
.env
.env.*
!.env.example
backend/data/
*.log
__pycache__/
*.py[cod]
node_modules/
dist/
.pytest_cache/

# артефакты сборки фронта
frontend/dist/

# локальные артефакты прогонов: журналы модели, обратная связь, индексы
ml/*.jsonl
ml/**/*.joblib
# исключение: индекс базы знаний — это данные, а не прогон. Без него
# поиск фрагментов (RAG) и автопилот работают вслепую.
!ml/doreposta/kb_index.joblib

# банк знаний пополняется при проверках: в git едет только пустой шаблон
ml/lakmus/data/knowledge_bank.json
ml/lakmus/data/.bank-*.tmp
docs/demo/*.webm
ml/data/samples/
ml/data/labels.jsonl
ml/data/results_live.jsonl
