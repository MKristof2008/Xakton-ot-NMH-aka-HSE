{
  "log_level": "INFO",
  "log_to_file": true,
  "retention_days": 30,
  "collector": {
    "interval_s": 900,
    "max_concurrency": 4,
    "request_timeout_s": 20,
    "retries": 3,
    "backoff_s": 2.0,
    "respect_robots": true,
    "fetch_article_text": true,
    "article_fetch_limit_per_source": 6,
    "max_items_per_source": 40,
    "min_text_chars": 80,
    "near_dup_hamming": 3,
    "near_dup_window_days": 3,
    "failure_cooldown_s": 1800
  },
  "verifier": {
    "enabled": true,
    "llm_enabled": true,
    "llm_hourly_budget": 40,
    "llm_daily_budget": 600,
    "verify_per_cycle": 12,
    "_пороги_разметки": "ниже min_label_confidence метка не попадает в обучение",
    "min_label_confidence": 0.6,
    "min_sources_for_real": 2,
    "claims_full_support_conf": 0.8,
    "claims_full_contradict_conf": 0.85,
    "claims_partial_conf": 0.7,
    "_очередь": "сколько раз перепроверять материал и когда сдаваться",
    "max_verify_attempts": 3,
    "uncertain_ttl_hours": 48,
    "ml_reliability": 0.45,
    "max_sources": 6,
    "rag_top_k": 2,
    "min_overlap": 0.15,
    "trusted_domains": [
      "tass.ru",
      "ria.ru",
      "interfax.ru",
      "rbc.ru",
      "lenta.ru",
      "kommersant.ru",
      "banki.ru",
      "meduza.io",
      "cbr.ru",
      "vedomosti.ru",
      "forbes.ru",
      "stopfake.org",
      "provereno.media",
      "euvsdisinfo.eu",
      "snopes.com"
    ],
    "min_calls_per_item": 3,
    "claims_partial_share": 0.5,
    "claims_max_unresolved_share": 0.5
  },
  "trainer": {
    "enabled": true,
    "backend": "auto",
    "min_new_examples": 50,
    "min_label_confidence": 0.6,
    "_активация": "новая модель публикуется по правилу из autopilot/README.md",
    "min_f1_gain": 0.005,
    "f1_tolerance": 0.005,
    "min_logloss_gain": 0.002,
    "min_auc_gain": 0.002,
    "min_data_growth": 0.1,
    "max_precision_drop": 0.01,
    "_абсолютный_порог": "применяется, если сравнение со старой моделью недостоверно (утечка данных)",
    "min_accept_f1": 0.8,
    "min_accept_precision": 0.75,
    "eval_share_ru": 0.2,
    "eval_share_verified": 0.15,
    "min_fresh_eval": 15,
    "min_comparison_n": 40,
    "holdout_max_per_class": 200,
    "ru_repeat": 20,
    "verified_repeat": 25,
    "use_en_corpus": true,
    "max_en_rows": 8000,
    "seed": 42,
    "promote_to_app": false,
    "keep_versions": 8,
    "transformer_model": "cointegrated/rubert-tiny2",
    "transformer_epochs": 2.0,
    "min_train_examples": 30
  },
  "sources": [
